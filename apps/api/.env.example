NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/realestate_ai?schema=public

# API interna (troque por um segredo longo em produção)
INTERNAL_API_KEY=dev-internal-key-change-me
DEFAULT_TENANT_ID=tenant_demo

# mock | openai
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MAX_RETRIES=1

# mock | meta
WHATSAPP_PROVIDER=mock
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v23.0

# O worker da outbox envia eventos para este webhook do n8n quando definido.
N8N_EVENTS_WEBHOOK_URL=
N8N_SHARED_SECRET=
OUTBOX_POLL_INTERVAL_MS=5000

# Custo aproximado configurável (USD por 1 milhão de tokens)
LLM_INPUT_USD_PER_MILLION=0
LLM_OUTPUT_USD_PER_MILLION=0
