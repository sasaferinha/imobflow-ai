{
  "name": "sites-project",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:production": "pnpm run test && node scripts/test-dashboard-sync.cjs && next build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "node scripts/test-security.cjs && node scripts/test-account-access.cjs && node scripts/test-demo-conversations.cjs && node scripts/test-match-workflow.cjs && node scripts/test-automations.cjs && node scripts/test-property-deals.cjs && node scripts/test-immediate-property-match.cjs && node scripts/test-n8n-property-dispatch.cjs",
    "test:account-sql": "node scripts/test-account-sql.cjs",
    "test:n8n": "node scripts/test-immediate-property-match.cjs && node scripts/test-n8n-property-dispatch.cjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "next": "16.3.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
