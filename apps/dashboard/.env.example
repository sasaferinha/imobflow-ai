# Server only. Never prefix server secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
APP_BASE_URL=https://imobflow-ai-rosy.vercel.app

# Deferred by the user. Leave both unset until a sending domain is verified.
RESEND_API_KEY=
PASSWORD_EMAIL_FROM=

# Optional integrations, disabled until independently configured and tested.
CRON_SECRET=
N8N_PROPERTY_AUTOMATION_CONNECTIONS=

# Meta WhatsApp Cloud API. These values are server-only and must be added to
# Vercel and Meta directly; never place tokens or the app secret in source code.
META_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# JSON array: [{"companyId":"uuid","phoneNumberId":"digits","enabled":true}]
WHATSAPP_META_CONNECTIONS=
