# Server only. Never prefix server secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
APP_BASE_URL=https://imobflow-ai-rosy.vercel.app

# Deferred by the user. Leave both unset until a sending domain is verified.
RESEND_API_KEY=
PASSWORD_EMAIL_FROM=

# Optional integrations, disabled until independently configured and tested.
CRON_SECRET=
N8N_PROPERTY_AUTOMATION_CONNECTIONS=
# n8n qualification replies. The agent is called after a verified inbound
# WhatsApp message and its accepted reply is sent automatically within 24 hours.
N8N_ATTENDANCE_WEBHOOK_URL=
N8N_ATTENDANCE_WEBHOOK_SECRET=

# Meta WhatsApp Cloud API. These values are server-only and must be added to
# Vercel and Meta directly; never place tokens or the app secret in source code.
META_APP_SECRET=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Token required only for receiving photo messages. Prefer the separate shared
# secret below, or use a per-connection accessToken in the JSON for multi-number setups.
WHATSAPP_META_CONNECTIONS=
META_WHATSAPP_ACCESS_TOKEN=
# Optional, defaults to v26.0.
META_WHATSAPP_GRAPH_VERSION=v26.0
